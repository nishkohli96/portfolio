{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "experimentalOperatorPosition": "start",
  "singleAttributePerLine": true,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "insertFinalNewline": true,
  "overrides": [],
  "ignorePatterns": []
}
